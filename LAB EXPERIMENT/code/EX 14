
import math

scores = [3, 5, 6, 9, 1, 2, 0, -1]
max_depth = 3

def alphabeta(depth, node, is_max, alpha, beta):
    if depth == max_depth:
        print("    " * depth + "Leaf:", scores[node])
        return scores[node]

    name = "MAX" if is_max else "MIN"
    print("    " * depth + name + " Node", node)

    if is_max:
        best = -math.inf

        for i in range(2):
            child = node * 2 + i

            value = alphabeta(
                depth + 1, child, False, alpha, beta
            )

            best = max(best, value)
            alpha = max(alpha, best)

            if alpha >= beta:
                print("    " * (depth + 1) +
                      "Pruned remaining branch")
                break

        print("    " * depth + "MAX value:", best)
        return best

    else:
        best = math.inf

        for i in range(2):
            child = node * 2 + i

            value = alphabeta(
                depth + 1, child, True, alpha, beta
            )

            best = min(best, value)
            beta = min(beta, best)

            if alpha >= beta:
                print("    " * (depth + 1) +
                      "Pruned remaining branch")
                break

        print("    " * depth + "MIN value:", best)
        return best


print("ALPHA-BETA PRUNING GAME TREE")
best_score = alphabeta(
    0, 0, True, -math.inf, math.inf
)

print("\nBest score:", best_score)
