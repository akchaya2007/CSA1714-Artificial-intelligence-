
import heapq

graph = {
    'A': [('B', 2), ('C', 4)],
    'B': [('D', 3), ('E', 5)],
    'C': [('F', 2)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 3)],
    'G': []
}

heuristic = {
    'A': 7,
    'B': 6,
    'C': 4,
    'D': 5,
    'E': 3,
    'F': 2,
    'G': 0
}

def greedy_search(start, goal):
    pq = [(heuristic[start], start, [start])]
    visited = set()

    while pq:
        h, node, path = heapq.heappop(pq)

        if node in visited:
            continue

        visited.add(node)

        if node == goal:
            return path

        for neighbor, cost in graph[node]:
            if neighbor not in visited:
                heapq.heappush(
                    pq, (heuristic[neighbor], neighbor,
                         path + [neighbor])
                )

    return None

start = 'A'
goal = 'G'

path = greedy_search(start, goal)

if path:
    print("Path found:", " -> ".join(path))
else:
    print("Path not found")

