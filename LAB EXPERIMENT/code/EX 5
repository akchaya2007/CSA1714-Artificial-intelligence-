from collections import deque

def is_safe(m, c):
    if m < 0 or c < 0 or m > 3 or c > 3:
        return False

    if m > 0 and m < c:
        return False

    m2 = 3 - m
    c2 = 3 - c

    if m2 > 0 and m2 < c2:
        return False

    return True


def solve():
    start = (3, 3, 0)
    goal = (0, 0, 1)

    queue = deque()
    queue.append((start, []))
    visited = set()

    moves = [
        (1, 0), (2, 0),
        (0, 1), (0, 2),
        (1, 1)
    ]

    while queue:
        state, path = queue.popleft()

        if state in visited:
            continue

        visited.add(state)

        m, c, boat = state
        new_path = path + [state]

        if state == goal:
            return new_path

        for dm, dc in moves:
            if boat == 0:
                new_m = m - dm
                new_c = c - dc
                new_boat = 1
            else:
                new_m = m + dm
                new_c = c + dc
                new_boat = 0

            new_state = (new_m, new_c, new_boat)

            if is_safe(new_m, new_c) and new_state not in visited:
                queue.append((new_state, new_path))

    return None


solution = solve()

print("Solution:")

for state in solution:
    m, c, boat = state

    side = "Left" if boat == 0 else "Right"

    print("Missionaries:", m,
          "Cannibals:", c,
          "Boat:", side)
